<.admin_layout current_page="libraries" title="Ebook Libraries">
  <div class="card bg-base-100 shadow-xl border border-base-300">
    <div class="card-body">
      <div class="flex justify-between items-center mb-4">
        <h2 class="card-title">Ebook Libraries</h2>
        <button phx-click="open_new_modal" class="btn btn-primary">
          New Library
        </button>
      </div>

      <%= if Enum.empty?(@libraries) do %>
        <div class="text-center py-12 text-base-content/60">
          <p class="text-lg">No libraries configured</p>
          <p class="text-sm mt-2">Add a library to start managing your ebook collection</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>Name</th>
                <th>Path</th>
                <th>Scan Mode</th>
                <th>Status</th>
                <th>Last Scanned</th>
                <th class="w-96">Actions</th>
              </tr>
            </thead>
            <tbody>
              <%= for library <- @libraries do %>
                <tr>
                  <td>{library.name}</td>
                  <td class="font-mono text-sm">{library.path}</td>
                  <td>
                    <span class={"badge #{scan_mode_badge_class(library.scan_mode)}"}>
                      {library.scan_mode}
                    </span>
                  </td>
                  <td>
                    <div class="flex flex-col gap-1">
                      <span class={"badge #{status_badge_class(library.scanning_status)}"}>
                        {library.scanning_status}
                      </span>
                      <%= if library.scan_progress_total && library.scan_progress_current do %>
                        <div class="text-xs text-base-content/70">
                          <div class="flex items-center gap-2">
                            <span class="font-semibold">{library.scan_progress_stage}</span>
                            <span>
                              {library.scan_progress_current}/{library.scan_progress_total} ({floor(
                                library.scan_progress_current * 100 / library.scan_progress_total
                              )}%)
                            </span>
                          </div>
                          <progress
                            class="progress progress-primary w-full h-2 mt-1"
                            value={library.scan_progress_current}
                            max={library.scan_progress_total}
                          >
                          </progress>
                        </div>
                      <% end %>
                      <%= if library.scanning_status == "failed" && library.last_scan_error do %>
                        <span class="text-xs text-error" title={library.last_scan_error}>
                          {String.slice(library.last_scan_error, 0..50)}{if String.length(
                                                                              library.last_scan_error
                                                                            ) > 50,
                                                                            do: "...",
                                                                            else: ""}
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td>
                    <%= if library.last_scanned_at do %>
                      {Calendar.strftime(library.last_scanned_at, "%Y-%m-%d %H:%M")}
                    <% else %>
                      <span class="text-base-content/40">Never</span>
                    <% end %>
                  </td>
                  <td>
                    <div class="flex gap-2">
                      <button
                        phx-click="open_edit_modal"
                        phx-value-id={library.id}
                        class="btn btn-sm btn-ghost"
                        title="Edit library settings"
                      >
                        Edit
                      </button>
                      <button
                        phx-click="scan_now"
                        phx-value-id={library.id}
                        class="btn btn-sm btn-ghost"
                        disabled={library.scanning_status == "scanning"}
                        title={
                          if library.scanning_status == "scanning",
                            do: "Scan in progress",
                            else: "Manually trigger a scan"
                        }
                      >
                        {if library.scanning_status == "scanning",
                          do: "Scanning...",
                          else: "Scan Now"}
                      </button>
                      <button
                        phx-click="delete_library"
                        phx-value-id={library.id}
                        data-confirm="Are you sure you want to delete this library? This will not delete the ebooks themselves, only the library configuration."
                        class="btn btn-sm btn-ghost text-error"
                        title="Delete library configuration"
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
  
<!-- Library Modal -->
  <%= if @show_modal do %>
    <div
      class="fixed inset-0 z-50 overflow-y-auto"
      aria-labelledby="modal-title"
      role="dialog"
      aria-modal="true"
    >
      <!-- Background overlay -->
      <div
        class="fixed inset-0 transition-opacity"
        style="background-color: rgba(0, 0, 0, 0.5);"
        phx-click="close_modal"
      >
      </div>
      
<!-- Centering container -->
      <div class="relative flex min-h-screen items-center justify-center p-4">
        <!-- Modal panel -->
        <div class="relative bg-base-100 rounded-lg text-left overflow-hidden shadow-xl transform transition-all w-full max-w-lg">
          <.form
            :let={f}
            for={@form}
            id="library-form"
            phx-change="validate_library"
            phx-submit="save_library"
            class="p-6"
          >
            <div class="mb-4">
              <h3 class="text-lg font-medium">
                {if @modal_action == :new, do: "Create Library", else: "Edit Library"}
              </h3>
            </div>

            <div class="space-y-4">
              <div>
                <.input field={f[:name]} type="text" label="Name" required />
              </div>

              <div>
                <label class="form-control w-full">
                  <div class="label">
                    <span class="label-text">Path</span>
                  </div>
                  <div class="flex gap-2">
                    <.input
                      field={f[:path]}
                      type="text"
                      required
                      placeholder="/home/user/books"
                      class="flex-1"
                    />
                    <button type="button" phx-click="open_tree_picker" class="btn btn-secondary">
                      Browse
                    </button>
                  </div>
                </label>
              </div>

              <div>
                <.input
                  field={f[:scan_mode]}
                  type="select"
                  label="Scan Mode"
                  options={[
                    {"Manual", "manual"},
                    {"Auto Watch", "auto_watch"},
                    {"Scheduled", "scheduled"}
                  ]}
                  required
                />
              </div>

              <%= if Phoenix.HTML.Form.input_value(f, :scan_mode) == "scheduled" do %>
                <div id="schedule-field">
                  <.input
                    field={f[:schedule]}
                    type="text"
                    label="Schedule (Cron Expression)"
                    placeholder="0 */6 * * *"
                  />
                  <p class="text-xs text-base-content/60 mt-1">
                    Format: minute hour day month weekday. Examples: "0 */6 * * *" (every 6 hours), "0 0 * * *" (daily at midnight), "0 9 * * 1" (Mondays at 9am)
                  </p>
                </div>
              <% end %>
            </div>

            <div class="mt-6 flex justify-end gap-3">
              <button type="button" phx-click="close_modal" class="btn btn-ghost">
                Cancel
              </button>
              <button type="submit" class="btn btn-primary">
                {if @modal_action == :new, do: "Create", else: "Update"}
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  <% end %>
  
<!-- Tree Picker Modal -->
  <%= if @show_tree_picker do %>
    <div
      class="fixed inset-0 z-50 overflow-y-auto"
      aria-labelledby="tree-picker-title"
      role="dialog"
      aria-modal="true"
    >
      <!-- Background overlay -->
      <div
        class="fixed inset-0 transition-opacity"
        style="background-color: rgba(0, 0, 0, 0.5);"
        phx-click="close_tree_picker"
      >
      </div>
      
<!-- Centering container -->
      <div class="relative flex min-h-screen items-center justify-center p-4">
        <!-- Modal panel -->
        <div class="relative bg-base-100 rounded-lg text-left overflow-hidden shadow-xl transform transition-all w-full max-w-2xl">
          <div class="p-6">
            <div class="mb-4">
              <h3 class="text-lg font-medium" id="tree-picker-title">
                Select Directory
              </h3>
              <%= if @tree_selected_path do %>
                <p class="text-sm text-base-content/60 mt-2">
                  Selected: <span class="font-mono">{@tree_selected_path}</span>
                </p>
              <% end %>
            </div>

            <FuzzyCatalogWeb.DirectoryTree.tree
              id="directory-tree"
              current_path={@tree_current_path}
              selected_path={@tree_selected_path}
              expanded_paths={@tree_expanded_paths}
            />

            <div class="mt-6 flex justify-end gap-3">
              <button type="button" phx-click="close_tree_picker" class="btn btn-ghost">
                Cancel
              </button>
              <button
                type="button"
                phx-click="use_selected_path"
                class="btn btn-primary"
                disabled={is_nil(@tree_selected_path)}
              >
                Use This Path
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</.admin_layout>
